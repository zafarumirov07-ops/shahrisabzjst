# Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable" (sb_publishable_...) yoki eski "anon" kalit. Brauzerga chiqishi xavfsiz; RLS himoya qiladi.
# NEXT_PUBLIC_SUPABASE_ANON_KEY nomi ham qabul qilinadi.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Asosiy domen. Subdomenlar (talimsifati.<domen>) shundan hosil qilinadi.
# Lokal ishlab chiqishda: localhost:3000  (talimsifati.localhost:3000 ham ishlaydi)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# MAXFIY kalitni (sb_secret_... / service_role) bu loyihaga va Vercelga qo'shmang: ilova uni ishlatmaydi.
