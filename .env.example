# ===== Ochiq sozlamalar (brauzerga chiqadi) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable" (sb_publishable_...) yoki eski "anon" kalit. RLS himoya qiladi. NEXT_PUBLIC_SUPABASE_ANON_KEY nomi ham qabul qilinadi.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Asosiy domen. Subdomenlar (talimsifati.<domen>) shundan hosil qilinadi. Lokal: localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ===== MAXFIY sozlamalar (faqat server; NEXT_PUBLIC_ qo'shmang!) =====
# Admin panel bazaga shu kalit bilan yozadi (Supabase, Project Settings, API Keys, Secret key)
SUPABASE_SECRET_KEY=

# Admin panelga kirish (/admin). Vercel, Settings, Environment Variables ga kiriting.
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Ixtiyoriy: sessiya imzosi uchun uzun tasodifiy matn (kamida 32 belgi)
ADMIN_SESSION_SECRET=

# Ixtiyoriy qo'shimcha hisoblar:
#   EDITOR_LOGIN / EDITOR_PASSWORD    - faqat asosiy sayt kontentini tahrirlaydi
#   QUALITY_LOGIN / QUALITY_PASSWORD  - faqat "Ta'lim sifati" saytini tahrirlaydi

# Avto tarjima (admin panelda matn saqlanganda bo'sh tillar to'ldiriladi). Standart: bepul MyMemory (kuniga ~5000 belgi).
# TRANSLATE_PROVIDER=mymemory | google | off
# MYMEMORY_EMAIL=...            (ixtiyoriy: limitni ~50000 belgigacha oshiradi)
# GOOGLE_TRANSLATE_API_KEY=...  (TRANSLATE_PROVIDER=google bo'lsa)
